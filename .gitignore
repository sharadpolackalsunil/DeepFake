# ============================================
# S-MSDT Project .gitignore
# ============================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# ── PyTorch / Model Artifacts ──
*.pt
*.pth
*.onnx
*.engine
*.plan
*.trt
calib_cache.bin

# ── Data (large files — download via scripts, don't commit) ──
data/raw/
data/cache/
data/splits/*.csv
!data/raw/.gitkeep
!data/cache/.gitkeep
!data/splits/.gitkeep

# ── Outputs ──
outputs/checkpoints/
outputs/logs/
outputs/*.onnx
outputs/*.engine
outputs/triton_repo/
!outputs/.gitkeep

# ── Experiment tracking ──
wandb/
mlruns/
*.wandb

# ── IDEs ──
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Jupyter ──
.ipynb_checkpoints/
*.ipynb

# ── Claude / Agents ──
.claude/*
!.claude/commands/
.agents/

# ── Docker ──
*.log
docker-compose.override.yml

# ── Misc ──
*.tmp
*.bak
*.orig
.env
.env.local
# Claude
.claude/
