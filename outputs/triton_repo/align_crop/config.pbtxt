name: "align_crop"
backend: "python"
max_batch_size: 16
input [
  {
    name: "input_image"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  },
  {
    name: "bboxes"
    data_type: TYPE_FP32
    dims: [ -1, 5 ]
  },
  {
    name: "kpss"
    data_type: TYPE_FP32
    dims: [ -1, 10 ]
  }
]
output [
  {
    name: "cropped_faces"
    data_type: TYPE_FP32
    dims: [ -1, 3, 224, 224 ]
  }
]
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
