name: "ensemble"
platform: "ensemble"
max_batch_size: 1
input [
  {
    name: "VIDEO_FRAMES"
    data_type: TYPE_UINT8
    dims: [ -1, -1, -1, 3 ]
  }
]
output [
  {
    name: "FINAL_PREDICTION"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
ensemble_scheduling {
  step [
    {
      model_name: "scrfd"
      model_version: -1
      input_map {
        key: "input_image"
        value: "VIDEO_FRAMES"
      }
      output_map {
        key: "bboxes"
        value: "BBOXES"
      }
      output_map {
        key: "kpss"
        value: "KPSS"
      }
    },
    {
      model_name: "align_crop"
      model_version: -1
      input_map {
        key: "input_image"
        value: "VIDEO_FRAMES"
      }
      input_map {
        key: "bboxes"
        value: "BBOXES"
      }
      input_map {
        key: "kpss"
        value: "KPSS"
      }
      output_map {
        key: "cropped_faces"
        value: "CROPPED_FACES"
      }
    },
    {
      model_name: "smsdt"
      model_version: -1
      input_map {
        key: "input_frames"
        value: "CROPPED_FACES"
      }
      output_map {
        key: "prediction"
        value: "CHUNK_PREDICTIONS"
      }
    },
    {
      model_name: "top_k_aggregator"
      model_version: -1
      input_map {
        key: "chunk_predictions"
        value: "CHUNK_PREDICTIONS"
      }
      output_map {
        key: "video_prediction"
        value: "FINAL_PREDICTION"
      }
    }
  ]
}
