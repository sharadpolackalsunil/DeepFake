name: "smsdt"
platform: "tensorrt_plan"
max_batch_size: 16
input [
  {
    name: "input_frames"
    data_type: TYPE_FP32
    dims: [ 8, 3, 224, 224 ]
  }
]
output [
  {
    name: "prediction"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 5000
}
